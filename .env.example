# ── LLM ────────────────────────────────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Vector Store ───────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=medical_rag
PARENT_COLLECTION_NAME=medical_rag_parents

# ── Embedding ──────────────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# ── Retrieval ──────────────────────────────────────────────────────────────────
TOP_K=8
PARENT_TOP_K=3
SCORE_THRESHOLD=0.3
HYBRID_ALPHA=0.6
MULTI_QUERY_COUNT=3
RERANK_TOP_N=5

# ── Reranking ──────────────────────────────────────────────────────────────────
BGE_RERANKER_MODEL=BAAI/bge-reranker-base
CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
ENABLE_BGE_RERANKER=true
ENABLE_CROSS_ENCODER=true

# ── Image Processing (PDF-embedded images) ─────────────────────────────────────
IMAGE_STORE_PATH=uploads/images
MIN_IMAGE_WIDTH=80
MIN_IMAGE_HEIGHT=80

# ── Chunking ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
PARENT_CHUNK_SIZE=2048
PARENT_CHUNK_OVERLAP=128

# ── Confidence ─────────────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.55
HALLUCINATION_THRESHOLD=0.4

# ── App ────────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=INFO
